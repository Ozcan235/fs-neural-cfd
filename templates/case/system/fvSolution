FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;

    residualControl
    {
        p               @@RES_TOL@@;
        U               @@RES_TOL@@;
        "(k|omega)"     @@RES_TOL@@;
    }
}

relaxationFactors
{
    fields
    {
        p               @@RELAX_P@@;
    }
    equations
    {
        U               @@RELAX_U@@;
        "(k|omega)"     @@RELAX_TURB@@;
    }
}
